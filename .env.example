# ============================================================
# JOBFLOW — .env.example
#
# The static frontend does NOT read .env files directly (there is
# no build step / bundler to inject them). This file exists purely
# as a reference for the two values you need — copy them into
# js/config.js instead (see config.example.js).
#
# If you deploy Edge Functions, SUPABASE_SERVICE_ROLE_KEY should be
# set as a Supabase secret (`supabase secrets set ...`), never here.
# ============================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (Edge Functions) — never expose in the browser or Git.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
